# Copy to .env (never commit .env). Only the keys are required.
ROOSTOO_API_KEY=
ROOSTOO_SECRET_KEY=
ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# Optional overrides (defaults live in bot/config.py — prefer changing them there,
# in a commit, so every strategy change is traceable in git history).
# DRY_RUN=false
# TOP_K=4
# TARGET_DAILY_VOL=0.02
# MAX_DRAWDOWN=0.12
